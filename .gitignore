# ---------------------------------------------------------------------------
# VERITABANI BILGILERI - ASLA COMMIT ETMEYIN
# ---------------------------------------------------------------------------
config/db.php
config/*.local.php

# ---------------------------------------------------------------------------
# VERITABANI DUMP'LARI
# SQL/localhost.sql icinde gercek kullanici kayitlari, e-posta adresleri ve
# parola ozetleri bulunuyor. Repoya alinmamalidir.
# ---------------------------------------------------------------------------
SQL/*.sql
SQL/yedekler/
!SQL/.gitkeep

# ---------------------------------------------------------------------------
# LISANS
# lisans.php icinde urunun lisans anahtari var. Anahtar commit edilirse
# herkese acik olur; sifirlanamaz. Repoya alinmamalidir.
# ---------------------------------------------------------------------------
lisans.php

# ---------------------------------------------------------------------------
# PROJE RAPORU
# Guvenlik denetim raporu. Urunun aciklarini (SQLi, MD5 parola, XSS) tek tek
# listeler. Ticari script icin repoda tutulmamali; AGENTS.md ve
# opencode.jsonc yerel kopyaya referans verir.
# ---------------------------------------------------------------------------
PROJE_RAPORU.md

# ---------------------------------------------------------------------------
# KULLANICI YUKLEMLERI (calisma aninda uretilen icerik)
# Tema varliklari (uploads/images) ve koruyucu index.html dosyalari repoda
# kalir; kullaniciya ait gorseller tutulmaz.
# ---------------------------------------------------------------------------
uploads/foto/*
uploads/ajax/*
uploads/files/*
uploads/uye_kapak/*
uploads/uye_profil/*
uploads/magaza_kapak/*
uploads/magaza_profil/*
uploads/.thumbs/

# Yuklenen dosya adlari hash/tarih icerdigi icin, repoya girmemis olsa bile
# asagidaki desenleri de engelle
uploads/images/*/
!**/index.html

